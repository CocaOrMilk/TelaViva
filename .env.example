# Copie para .env e ajuste. NUNCA suba o .env para o repositório.

# Chave aleatória longa para assinar as sessões (ex.: openssl rand -hex 32)
SESSION_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_CARACTERES

PORT=3000
# Interface em que o servidor escuta (use 127.0.0.1 atrás de um proxy reverso)
# HOST=0.0.0.0
# development | production (production exige HTTPS: o cookie de sessão é "secure")
NODE_ENV=development

# Pasta de dados (users.json, logs/). Padrão: ./data
# DATA_DIR=./data

# Nomes das 3 salas fixas, separados por vírgula (padrão: Sala 1, Sala 2, Sala 3)
# ROOM_NAMES=Jogos,Filmes,Conversa

# Opcional: servidor TURN para conexões entre redes restritivas (STUN público já é usado por padrão).
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.exemplo.com:3478","username":"USUARIO","credential":"SENHA"}]
