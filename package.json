{
  "name": "tela-viva",
  "version": "1.4.0",
  "private": true,
  "description": "Compartilhamento de tela com audio isolado, interface simplificada, diagnostico WebRTC, qualidade HD/Full HD, audio nativo de janela/tela quando suportado, login e WebRTC",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "criar-usuario": "node scripts/create-user.js",
